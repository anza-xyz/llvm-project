; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -march=sbf -mcpu=v3 | FileCheck %s --check-prefix=CHECK
; RUN: llc < %s -march=sbf -mcpu=v3 -mattr=+alu32 | FileCheck %s --check-prefix=CHECK-ALU32

; SBF has no condition register, so the comparison is part of the branch. The
; select pseudo expansion moves everything after the pseudo into the tail
; block, which makes consecutive selects nest: without merging, each one gets
; its own diamond and its own copy of the comparison.

; Two selects on one condition share a single branch.
define i64 @two(i64 %a, i64 %b, i64 %p, i64 %q) {
; CHECK-LABEL: two:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mov64 r0, r4
; CHECK-NEXT:    jsgt r1, r2, .LBB0_1
; CHECK-NEXT:  # %bb.2:
; CHECK-NEXT:    mov64 r1, r3
; CHECK-NEXT:    ja .LBB0_3
; CHECK-NEXT:  .LBB0_1:
; CHECK-NEXT:    mov64 r1, r0
; CHECK-NEXT:    mov64 r0, r3
; CHECK-NEXT:  .LBB0_3:
; CHECK-NEXT:    add64 r0, r1
; CHECK-NEXT:    exit
;
; CHECK-ALU32-LABEL: two:
; CHECK-ALU32:       # %bb.0:
; CHECK-ALU32-NEXT:    mov64 r0, r4
; CHECK-ALU32-NEXT:    jsgt r1, r2, .LBB0_1
; CHECK-ALU32-NEXT:  # %bb.2:
; CHECK-ALU32-NEXT:    mov64 r1, r3
; CHECK-ALU32-NEXT:    ja .LBB0_3
; CHECK-ALU32-NEXT:  .LBB0_1:
; CHECK-ALU32-NEXT:    mov64 r1, r0
; CHECK-ALU32-NEXT:    mov64 r0, r3
; CHECK-ALU32-NEXT:  .LBB0_3:
; CHECK-ALU32-NEXT:    add64 r0, r1
; CHECK-ALU32-NEXT:    exit
  %c = icmp sgt i64 %a, %b
  %x = select i1 %c, i64 %p, i64 %q
  %y = select i1 %c, i64 %q, i64 %p
  %r = add i64 %x, %y
  ret i64 %r
}

; Only the comparison has to match, not the width of the selected values: a
; 64-bit and a 32-bit select sharing one 64-bit compare still merge.
define i64 @mixed_width(i64 %a, i64 %b, i64 %p, i64 %q, i32 %m) {
; CHECK-LABEL: mixed_width:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mov64 r0, r3
; CHECK-NEXT:    jsgt r1, r2, .LBB1_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    mov64 r5, 7
; CHECK-NEXT:    mov64 r0, r4
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    lsh64 r5, 32
; CHECK-NEXT:    rsh64 r5, 32
; CHECK-NEXT:    add64 r0, r5
; CHECK-NEXT:    exit
;
; CHECK-ALU32-LABEL: mixed_width:
; CHECK-ALU32:       # %bb.0:
; CHECK-ALU32-NEXT:    mov64 r0, r3
; CHECK-ALU32-NEXT:    jsgt r1, r2, .LBB1_2
; CHECK-ALU32-NEXT:  # %bb.1:
; CHECK-ALU32-NEXT:    mov32 w5, 7
; CHECK-ALU32-NEXT:    mov64 r0, r4
; CHECK-ALU32-NEXT:  .LBB1_2:
; CHECK-ALU32-NEXT:    mov32 r1, w5
; CHECK-ALU32-NEXT:    add64 r0, r1
; CHECK-ALU32-NEXT:    exit
  %c = icmp sgt i64 %a, %b
  %x = select i1 %c, i64 %p, i64 %q
  %w = select i1 %c, i32 %m, i32 7
  %we = zext i32 %w to i64
  %r = add i64 %x, %we
  ret i64 %r
}

; A comparison against an immediate merges the same way.
define i64 @imm_cond(i32 %k, i64 %a, i64 %b, i64 %c, i64 %d) {
; CHECK-LABEL: imm_cond:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mov64 r0, r2
; CHECK-NEXT:    lsh64 r1, 32
; CHECK-NEXT:    rsh64 r1, 32
; CHECK-NEXT:    jeq r1, 0, .LBB2_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    mov64 r4, r5
; CHECK-NEXT:    mov64 r0, r3
; CHECK-NEXT:  .LBB2_2:
; CHECK-NEXT:    xor64 r0, r4
; CHECK-NEXT:    exit
;
; CHECK-ALU32-LABEL: imm_cond:
; CHECK-ALU32:       # %bb.0:
; CHECK-ALU32-NEXT:    mov64 r0, r2
; CHECK-ALU32-NEXT:    jeq32 w1, 0, .LBB2_2
; CHECK-ALU32-NEXT:  # %bb.1:
; CHECK-ALU32-NEXT:    mov64 r4, r5
; CHECK-ALU32-NEXT:    mov64 r0, r3
; CHECK-ALU32-NEXT:  .LBB2_2:
; CHECK-ALU32-NEXT:    xor64 r0, r4
; CHECK-ALU32-NEXT:    exit
  %t = icmp eq i32 %k, 0
  %x = select i1 %t, i64 %a, i64 %b
  %y = select i1 %t, i64 %c, i64 %d
  %r = xor i64 %x, %y
  ret i64 %r
}

; Different conditions must not be merged: each needs its own branch.
define i64 @distinct_conds(i64 %a, i64 %b, i64 %p, i64 %q) {
; CHECK-LABEL: distinct_conds:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mov64 r0, r3
; CHECK-NEXT:    mov64 r3, r4
; CHECK-NEXT:    jslt r1, r2, .LBB3_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    mov64 r3, r0
; CHECK-NEXT:  .LBB3_2:
; CHECK-NEXT:    jsgt r1, r2, .LBB3_4
; CHECK-NEXT:  # %bb.3:
; CHECK-NEXT:    mov64 r0, r4
; CHECK-NEXT:  .LBB3_4:
; CHECK-NEXT:    add64 r0, r3
; CHECK-NEXT:    exit
;
; CHECK-ALU32-LABEL: distinct_conds:
; CHECK-ALU32:       # %bb.0:
; CHECK-ALU32-NEXT:    mov64 r0, r3
; CHECK-ALU32-NEXT:    mov64 r3, r4
; CHECK-ALU32-NEXT:    jslt r1, r2, .LBB3_2
; CHECK-ALU32-NEXT:  # %bb.1:
; CHECK-ALU32-NEXT:    mov64 r3, r0
; CHECK-ALU32-NEXT:  .LBB3_2:
; CHECK-ALU32-NEXT:    jsgt r1, r2, .LBB3_4
; CHECK-ALU32-NEXT:  # %bb.3:
; CHECK-ALU32-NEXT:    mov64 r0, r4
; CHECK-ALU32-NEXT:  .LBB3_4:
; CHECK-ALU32-NEXT:    add64 r0, r3
; CHECK-ALU32-NEXT:    exit
  %c1 = icmp sgt i64 %a, %b
  %c2 = icmp slt i64 %a, %b
  %x = select i1 %c1, i64 %p, i64 %q
  %y = select i1 %c2, i64 %q, i64 %p
  %r = add i64 %x, %y
  ret i64 %r
}

; A select feeding another select is a cascade, not a sibling: the second one's
; input is not available in the head block, so the run has to stop.
define i64 @cascade(i64 %a, i64 %b, i64 %p, i64 %q) {
; CHECK-LABEL: cascade:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mov64 r0, r3
; CHECK-NEXT:    jsgt r1, r2, .LBB4_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    mov64 r0, r4
; CHECK-NEXT:  .LBB4_2:
; CHECK-NEXT:    jsgt r1, r2, .LBB4_4
; CHECK-NEXT:  # %bb.3:
; CHECK-NEXT:    mov64 r0, r3
; CHECK-NEXT:  .LBB4_4:
; CHECK-NEXT:    exit
;
; CHECK-ALU32-LABEL: cascade:
; CHECK-ALU32:       # %bb.0:
; CHECK-ALU32-NEXT:    mov64 r0, r3
; CHECK-ALU32-NEXT:    jsgt r1, r2, .LBB4_2
; CHECK-ALU32-NEXT:  # %bb.1:
; CHECK-ALU32-NEXT:    mov64 r0, r4
; CHECK-ALU32-NEXT:  .LBB4_2:
; CHECK-ALU32-NEXT:    jsgt r1, r2, .LBB4_4
; CHECK-ALU32-NEXT:  # %bb.3:
; CHECK-ALU32-NEXT:    mov64 r0, r3
; CHECK-ALU32-NEXT:  .LBB4_4:
; CHECK-ALU32-NEXT:    exit
  %c = icmp sgt i64 %a, %b
  %x = select i1 %c, i64 %p, i64 %q
  %y = select i1 %c, i64 %x, i64 %p
  ret i64 %y
}

; An unrelated memory operation nearby does not prevent merging: it schedules
; clear of the two selects. The scan does stop at a memory operation that ends
; up between them, which costs a merge in code that reloads stack arguments
; between the selects.
define i64 @memory_between(i64 %a, i64 %b, i64 %p, i64 %q, ptr %m) {
; CHECK-LABEL: memory_between:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mov64 r0, r4
; CHECK-NEXT:    jsgt r1, r2, .LBB5_1
; CHECK-NEXT:  # %bb.2:
; CHECK-NEXT:    mov64 r1, r3
; CHECK-NEXT:    ja .LBB5_3
; CHECK-NEXT:  .LBB5_1:
; CHECK-NEXT:    mov64 r1, r0
; CHECK-NEXT:    mov64 r0, r3
; CHECK-NEXT:  .LBB5_3:
; CHECK-NEXT:    add64 r0, r1
; CHECK-NEXT:    ldxdw r1, [r5 + 0]
; CHECK-NEXT:    add64 r0, r1
; CHECK-NEXT:    exit
;
; CHECK-ALU32-LABEL: memory_between:
; CHECK-ALU32:       # %bb.0:
; CHECK-ALU32-NEXT:    mov64 r0, r4
; CHECK-ALU32-NEXT:    jsgt r1, r2, .LBB5_1
; CHECK-ALU32-NEXT:  # %bb.2:
; CHECK-ALU32-NEXT:    mov64 r1, r3
; CHECK-ALU32-NEXT:    ja .LBB5_3
; CHECK-ALU32-NEXT:  .LBB5_1:
; CHECK-ALU32-NEXT:    mov64 r1, r0
; CHECK-ALU32-NEXT:    mov64 r0, r3
; CHECK-ALU32-NEXT:  .LBB5_3:
; CHECK-ALU32-NEXT:    add64 r0, r1
; CHECK-ALU32-NEXT:    ldxdw r1, [r5 + 0]
; CHECK-ALU32-NEXT:    add64 r0, r1
; CHECK-ALU32-NEXT:    exit
  %c = icmp sgt i64 %a, %b
  %x = select i1 %c, i64 %p, i64 %q
  %l = load i64, ptr %m
  %y = select i1 %c, i64 %q, i64 %p
  %s = add i64 %x, %y
  %r = add i64 %s, %l
  ret i64 %r
}
