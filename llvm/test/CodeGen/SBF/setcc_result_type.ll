; An i1 carried through a phi and only then branched on. The boolean is a real
; cross-block value here, so it is materialized rather than folded into the
; branch; it must still be produced and tested consistently in one class.
define i64 @bool_phi(i32 %a, i32 %b, i64 %x) {
; CHECK-LABEL: bool_phi:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    mov64 r0, r3
; CHECK-NEXT:    lsh64 r2, 32
; CHECK-NEXT:    arsh64 r2, 32
; CHECK-NEXT:    lsh64 r1, 32
; CHECK-NEXT:    mov64 r3, 1
; CHECK-NEXT:    arsh64 r1, 32
; CHECK-NEXT:    jsle r1, r2, .LBB8_2
; CHECK-NEXT:  # %bb.1: # %m1
; CHECK-NEXT:    jsge r1, 0, .LBB8_3
; CHECK-NEXT:    ja .LBB8_4
; CHECK-NEXT:  .LBB8_2: # %m2
; CHECK-NEXT:    jsgt r2, 0, .LBB8_4
; CHECK-NEXT:  .LBB8_3: # %m2
; CHECK-NEXT:    mov64 r3, 0
; CHECK-NEXT:  .LBB8_4: # %join
; CHECK-NEXT:    and64 r3, 1
; CHECK-NEXT:    jne r3, 0, .LBB8_6
; CHECK-NEXT:  # %bb.5: # %join
; CHECK-NEXT:    mov64 r0, 0
; CHECK-NEXT:  .LBB8_6: # %join
; CHECK-NEXT:    exit
;
; CHECK-ALU32-LABEL: bool_phi:
; CHECK-ALU32:       # %bb.0: # %entry
; CHECK-ALU32-NEXT:    mov64 r0, r3
; CHECK-ALU32-NEXT:    # kill: def $w1 killed $w1 def $r1
; CHECK-ALU32-NEXT:    jsle32 w1, w2, .LBB8_2
; CHECK-ALU32-NEXT:  # %bb.1: # %m1
; CHECK-ALU32-NEXT:    rsh32 w1, 31
; CHECK-ALU32-NEXT:    ja .LBB8_4
; CHECK-ALU32-NEXT:  .LBB8_2: # %m2
; CHECK-ALU32-NEXT:    mov32 w1, 1
; CHECK-ALU32-NEXT:    jsgt32 w2, 0, .LBB8_4
; CHECK-ALU32-NEXT:  # %bb.3: # %m2
; CHECK-ALU32-NEXT:    mov32 w1, 0
; CHECK-ALU32-NEXT:  .LBB8_4: # %join
; CHECK-ALU32-NEXT:    and64 r1, 1
; CHECK-ALU32-NEXT:    jne r1, 0, .LBB8_6
; CHECK-ALU32-NEXT:  # %bb.5: # %join
; CHECK-ALU32-NEXT:    mov64 r0, 0
; CHECK-ALU32-NEXT:  .LBB8_6: # %join
; CHECK-ALU32-NEXT:    exit
;
; CHECK-V2-LABEL: bool_phi:
; CHECK-V2:       # %bb.0: # %entry
; CHECK-V2-NEXT:    mov64 r0, r3
; CHECK-V2-NEXT:    # kill: def $w1 killed $w1 def $r1
; CHECK-V2-NEXT:    mov32 r2, w2
; CHECK-V2-NEXT:    mov32 r3, w1
; CHECK-V2-NEXT:    jsle r3, r2, .LBB8_2
; CHECK-V2-NEXT:  # %bb.1: # %m1
; CHECK-V2-NEXT:    rsh32 w1, 31
; CHECK-V2-NEXT:    ja .LBB8_4
; CHECK-V2-NEXT:  .LBB8_2: # %m2
; CHECK-V2-NEXT:    mov32 w1, 1
; CHECK-V2-NEXT:    jsgt r2, 0, .LBB8_4
; CHECK-V2-NEXT:  # %bb.3: # %m2
; CHECK-V2-NEXT:    mov32 w1, 0
; CHECK-V2-NEXT:  .LBB8_4: # %join
; CHECK-V2-NEXT:    and64 r1, 1
; CHECK-V2-NEXT:    jne r1, 0, .LBB8_6
; CHECK-V2-NEXT:  # %bb.5: # %join
; CHECK-V2-NEXT:    mov64 r0, 0
; CHECK-V2-NEXT:  .LBB8_6: # %join
; CHECK-V2-NEXT:    exit
entry:
  %c0 = icmp sgt i32 %a, %b
  br i1 %c0, label %m1, label %m2

m1:
  %c1 = icmp slt i32 %a, 0
  br label %join

m2:
  %c2 = icmp sgt i32 %b, 0
  br label %join

join:
  %p = phi i1 [ %c1, %m1 ], [ %c2, %m2 ]
  %r = select i1 %p, i64 %x, i64 0
  ret i64 %r
}
