; getSetCCResultType() must only report i32 for a 32-bit comparison. Reporting
; i32 for 64-bit comparisons as well puts the boolean in GPR32, so each one
; that merges into a 64-bit phi, select, return or store needs a widening
; move, and the two halves of such a merge land in different register classes,
; which blocks tail merging and adds an unconditional jump.

; An i64 phi merging a constant with zext(i1) of a 64-bit comparison. Both
; zero-producing paths must share a single block; there must be no widening
; move and no extra 'ja'.
define i64 @zext_i64_cmp_phi(i64 %a, i64 %b) {
; CHECK-LABEL: zext_i64_cmp_phi:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    mov64 r3, r1
; CHECK-NEXT:    or64 r3, r2
; CHECK-NEXT:    jeq r3, 0, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %cont
; CHECK-NEXT:    mov64 r0, 1
; CHECK-NEXT:    jne r1, r2, .LBB0_3
; CHECK-NEXT:  .LBB0_2: # %cont
; CHECK-NEXT:    mov64 r0, 0
; CHECK-NEXT:  .LBB0_3: # %exit
; CHECK-NEXT:    exit
;
; CHECK-ALU32-LABEL: zext_i64_cmp_phi:
; CHECK-ALU32:       # %bb.0: # %entry
; CHECK-ALU32-NEXT:    mov64 r3, r1
; CHECK-ALU32-NEXT:    or64 r3, r2
; CHECK-ALU32-NEXT:    jeq r3, 0, .LBB0_2
; CHECK-ALU32-NEXT:  # %bb.1: # %cont
; CHECK-ALU32-NEXT:    mov64 r0, 1
; CHECK-ALU32-NEXT:    jne r1, r2, .LBB0_3
; CHECK-ALU32-NEXT:  .LBB0_2: # %cont
; CHECK-ALU32-NEXT:    mov64 r0, 0
; CHECK-ALU32-NEXT:  .LBB0_3: # %exit
; CHECK-ALU32-NEXT:    exit
;
; CHECK-V2-LABEL: zext_i64_cmp_phi:
; CHECK-V2:       # %bb.0: # %entry
; CHECK-V2-NEXT:    mov64 r3, r1
; CHECK-V2-NEXT:    or64 r3, r2
; CHECK-V2-NEXT:    jeq r3, 0, .LBB0_2
; CHECK-V2-NEXT:  # %bb.1: # %cont
; CHECK-V2-NEXT:    mov64 r0, 1
; CHECK-V2-NEXT:    jne r1, r2, .LBB0_3
; CHECK-V2-NEXT:  .LBB0_2: # %cont
; CHECK-V2-NEXT:    mov64 r0, 0
; CHECK-V2-NEXT:  .LBB0_3: # %exit
; CHECK-V2-NEXT:    exit
entry:
  %o = or i64 %a, %b
  %z = icmp eq i64 %o, 0
  br i1 %z, label %exit, label %cont

cont:
  %ne = icmp ne i64 %a, %b
  %e = zext i1 %ne to i64
  br label %exit

exit:
  %r = phi i64 [ 0, %entry ], [ %e, %cont ]
  ret i64 %r
}

; zext(i1) of a 64-bit comparison, materialized straight into the return
; register.
define i64 @zext_i64_cmp(i64 %a, i64 %b) {
; CHECK-LABEL: zext_i64_cmp:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mov64 r0, 1
; CHECK-NEXT:    jlt r1, r2, .LBB1_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    mov64 r0, 0
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    exit
;
; CHECK-ALU32-LABEL: zext_i64_cmp:
; CHECK-ALU32:       # %bb.0:
; CHECK-ALU32-NEXT:    mov64 r0, 1
; CHECK-ALU32-NEXT:    jlt r1, r2, .LBB1_2
; CHECK-ALU32-NEXT:  # %bb.1:
; CHECK-ALU32-NEXT:    mov64 r0, 0
; CHECK-ALU32-NEXT:  .LBB1_2:
; CHECK-ALU32-NEXT:    exit
;
; CHECK-V2-LABEL: zext_i64_cmp:
; CHECK-V2:       # %bb.0:
; CHECK-V2-NEXT:    mov64 r0, 1
; CHECK-V2-NEXT:    jlt r1, r2, .LBB1_2
; CHECK-V2-NEXT:  # %bb.1:
; CHECK-V2-NEXT:    mov64 r0, 0
; CHECK-V2-NEXT:  .LBB1_2:
; CHECK-V2-NEXT:    exit
  %c = icmp ult i64 %a, %b
  %z = zext i1 %c to i64
  ret i64 %z
}

